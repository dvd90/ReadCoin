<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-extrabold mb-1">Quiz time! ✏️</h1>
  <p class="text-stone-500 mb-6"><%= @book.title %> — get <%= Reading::PASS_SCORE %>% or more to earn 🪙 <%= @book.reward %></p>

  <%= form_with url: submit_quiz_play_book_path(@book), class: "space-y-5" do %>
    <% @quiz.questions.each_with_index do |q, i| %>
      <div class="bg-white rounded-2xl shadow p-5">
        <p class="font-bold mb-3"><%= i + 1 %>. <%= q["question"] %></p>
        <% q["choices"].each_with_index do |choice, ci| %>
          <label class="flex items-center gap-3 p-2 rounded-xl hover:bg-amber-50 cursor-pointer">
            <%= radio_button_tag "answers[#{i}]", ci, false, required: true %>
            <span><%= choice %></span>
          </label>
        <% end %>
      </div>
    <% end %>
    <%= submit_tag "Check my answers! ⭐", class: "w-full px-6 py-4 rounded-2xl bg-amber-500 hover:bg-amber-400 text-white font-extrabold text-lg cursor-pointer" %>
  <% end %>
</div>
