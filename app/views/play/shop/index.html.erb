<h1 class="text-3xl font-extrabold mb-1">Prize shop 🎁</h1>
<p class="text-stone-500 mb-6">You have <strong class="text-amber-500">🪙 <%= current_kid.coins %></strong> to spend!</p>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
  <% @rewards.each do |reward| %>
    <div class="bg-white rounded-2xl shadow p-5 text-center">
      <div class="text-5xl"><%= reward.emoji.presence || "🎁" %></div>
      <h2 class="font-bold mt-2"><%= reward.title %></h2>
      <p class="text-amber-500 font-extrabold">🪙 <%= reward.cost %></p>
      <% if current_kid.coins >= reward.cost %>
        <%= button_to "Get it!", play_redeem_path(reward), class: "mt-3 px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-white font-bold cursor-pointer" %>
      <% else %>
        <p class="mt-3 text-xs font-bold text-stone-400"><%= reward.cost - current_kid.coins %> more coins to go!</p>
      <% end %>
    </div>
  <% end %>
  <% if @rewards.empty? %>
    <p class="text-stone-500 col-span-3">No prizes yet — ask a grown-up to add some!</p>
  <% end %>
</div>

<% if @redemptions.any? %>
  <h2 class="font-extrabold text-xl mt-10 mb-3">My prizes</h2>
  <div class="bg-white rounded-2xl shadow divide-y divide-stone-100">
    <% @redemptions.each do |r| %>
      <div class="px-5 py-3 flex items-center gap-3 text-sm">
        <span><%= r.reward.emoji %> <strong><%= r.reward.title %></strong></span>
        <span class="flex-1"></span>
        <% if r.status == "pending" %>
          <span class="text-stone-400 font-bold">waiting for a grown-up ⏳</span>
        <% else %>
          <span class="text-green-600 font-bold">approved! ✅</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
