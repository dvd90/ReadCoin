<div class="w-full text-center py-16">
  <h1 class="text-6xl font-extrabold tracking-tight">📚 ReadCoin</h1>
  <p class="mt-4 text-2xl text-stone-500 font-medium">Read. Earn. Spend.</p>
  <p class="mt-6 max-w-xl mx-auto text-stone-600">
    Kids read real books, pass a comprehension quiz, and earn coins they can spend on
    rewards their parents set up — a trip to the zoo, movie night, you name it.
  </p>
  <div class="mt-10 flex justify-center gap-4">
    <%= link_to "I'm a kid — let's read! 🚀", play_root_path, class: "px-6 py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-white font-bold text-lg shadow" %>
    <% if authenticated? %>
      <%= link_to "Family dashboard", family_root_path, class: "px-6 py-3 rounded-2xl bg-stone-800 hover:bg-stone-700 text-white font-bold text-lg" %>
    <% else %>
      <%= link_to "Parent sign in", new_session_path, class: "px-6 py-3 rounded-2xl bg-stone-800 hover:bg-stone-700 text-white font-bold text-lg" %>
    <% end %>
  </div>
  <% unless authenticated? %>
    <p class="mt-4 text-sm text-stone-500">New here? <%= link_to "Create a family account", new_registration_path, class: "underline font-medium" %></p>
  <% end %>
</div>
