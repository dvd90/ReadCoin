<h1 class="text-3xl font-extrabold mb-2"><%= @book.title %></h1>
<p class="text-stone-500 mb-6">by <%= @book.author %> · <%= @book.genre %></p>
<p class="max-w-2xl"><%= @book.summary %></p>
<div class="mt-6 flex gap-3">
  <%= link_to "Edit", edit_family_book_path(@book), class: "underline" %>
  <%= link_to "Quiz", edit_family_book_quiz_path(@book), class: "underline" %>
</div>
