<div class="mx-auto md:w-1/2 w-full">
  <%= render "shared/flashes" %>
  <h1 class="font-bold text-4xl">Create your family account</h1>

  <%= form_with model: @user, url: registration_path, class: "contents" do |form| %>
    <% if @user.errors.any? %>
      <div class="py-2 px-4 bg-red-100 text-red-600 rounded-xl my-4">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, placeholder: "Email address", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= form.password_field :password, required: true, placeholder: "Password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= form.password_field :password_confirmation, required: true, placeholder: "Confirm password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>
    <%= form.submit "Sign up", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>
  <p class="mt-4 text-sm text-gray-500">Already have an account? <%= link_to "Sign in", new_session_path, class: "underline" %></p>
</div>
