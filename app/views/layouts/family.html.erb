<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ReadCoin — Family" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-stone-50 min-h-screen text-stone-800">
    <nav class="bg-white border-b border-stone-200">
      <div class="max-w-5xl mx-auto px-5 py-3 flex items-center gap-6">
        <%= link_to family_root_path, class: "font-extrabold text-lg text-amber-600" do %>📚 ReadCoin<% end %>
        <%= link_to "Dashboard", family_root_path, class: "text-sm font-medium hover:text-amber-600" %>
        <%= link_to "Kids", family_kids_path, class: "text-sm font-medium hover:text-amber-600" %>
        <%= link_to "Books", family_books_path, class: "text-sm font-medium hover:text-amber-600" %>
        <%= link_to "Rewards", family_rewards_path, class: "text-sm font-medium hover:text-amber-600" %>
        <%= link_to "Redemptions", family_redemptions_path, class: "text-sm font-medium hover:text-amber-600" %>
        <span class="flex-1"></span>
        <%= link_to "Kid mode →", play_root_path, class: "text-sm font-semibold text-amber-600" %>
        <%= button_to "Sign out", session_path, method: :delete, class: "text-sm text-stone-400 hover:text-stone-600 cursor-pointer" %>
      </div>
    </nav>
    <main class="max-w-5xl mx-auto px-5 py-8">
      <%= render "shared/flashes" %>
      <%= yield %>
    </main>
  </body>
</html>
